# ==============================================================================
# ZERMP ENTERPRISE DEPLOYMENT CONFIGURATION (VRIDHI FINANCIAL SERVICES)
# ==============================================================================

# --- APPLICATION CORE ---
APP_NAME=ZERMP-Enterprise
APP_ENV=development
APP_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=zermp-dev-insecure-secret-key-replace-in-production-min32chars
ALLOWED_HOSTS=*
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- POSTGRESQL (TRANSACTIONAL OLTP & SYSTEM OF RECORD) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zermp_core
POSTGRES_USER=zermp_admin
POSTGRES_PASSWORD=zermp_secure_dev_password_2026
DATABASE_URL=postgresql+asyncpg://zermp_admin:zermp_secure_dev_password_2026@postgres:5432/zermp_core
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# --- CLICKHOUSE (COLUMNAR OLAP FOR RISK CALCULATIONS & DRILL-DOWNS) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=zermp_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_dev_pass_2026

# --- REDIS (SESSION, DISTRIBUTED LOCKS & TOKEN-BUCKET RATE LIMITING) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_dev_password_2026
REDIS_DB=0
REDIS_URL=redis://:redis_secure_dev_password_2026@redis:6379/0

# --- OBJECT STORAGE (AWS S3 / LOCALSTACK WORM REGULATORY ARCHIVE) ---
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
S3_ENDPOINT_URL=http://s3:4566
S3_BUCKET_REPORTS=zermp-regulatory-reports
S3_BUCKET_INGEST=zermp-raw-ingestion
S3_USE_SSL=false

# Legacy MinIO compatibility aliases
MINIO_ENDPOINT=s3:4566
MINIO_ROOT_USER=test
MINIO_ROOT_PASSWORD=test
MINIO_BUCKET_REPORTS=zermp-regulatory-reports
MINIO_BUCKET_INGEST=zermp-raw-ingestion
MINIO_USE_SSL=false

# --- SFTP SERVICE (FINNONE BATCH DROP TARGET - DS-01) ---
SFTP_HOST=sftp
SFTP_PORT=22
SFTP_USER=finnone_etl
SFTP_PASSWORD=finnone_drop_password_2026
SFTP_REMOTE_DIR=/upload

# --- IDENTITY & ACCESS CONTROL (AZURE AD SSO & RBAC - CFG-UM-01) ---
AUTH_METHOD=SAML_MOCK
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MFA_ENFORCED_ROLES=["Admin","CRO","Head of Credit Risk","Internal Auditor"]

# --- REGULATORY PARAMETERS (RBI IRAC & BASEL III DEFAULTS) ---
NPA_DPD_THRESHOLD=90
SUBSTANDARD_PROVISION_SECURED=0.10
SUBSTANDARD_PROVISION_UNSECURED=0.10
D1_PROVISION_SECURED=0.25
D2_PROVISION_SECURED=0.40
D3_PROVISION_TOTAL=1.00
LOSS_PROVISION_TOTAL=1.00
